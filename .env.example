# Copy to .env and fill in. Use letters and numbers only for passwords (they go inside database URLs).
# Generate one with:  openssl rand -hex 24

# Database owner (used only by migrations) and the restricted app role (used by the API).
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too

# The public address people use to open Glimpse. Must match exactly (used for CSRF and cookies).
#   Local:   http://localhost:8090
#   Tunnel:  https://glimpse.yourdomain.com
APP_ORIGIN=http://localhost:8090

# Local port for the app on your Mac (localhost only).
HOST_PORT=8090

# Only needed with --profile tunnel. From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token.
CLOUDFLARE_TUNNEL_TOKEN=
