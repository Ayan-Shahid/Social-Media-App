# Copy to .env and fill in. Use letters and numbers only for passwords (they go inside database URLs).
# Generate one with:  openssl rand -hex 24

# Database owner (migrations only), the restricted app role (API), and the worker role.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
WORKER_DB_PASSWORD=change-me-three

# Object storage (SeaweedFS) secret key for the API and worker.
S3_SECRET_KEY=change-me-four

# The public address people use to open Glimpse. Must match exactly (used for CSRF, cookies,
# the websocket Origin check and the Google redirect URL).
#   Local:   http://localhost:8090
#   Tunnel:  https://glimpse.ayandev.app   (production, see docs/DEPLOY.md)
APP_ORIGIN=http://localhost:8090

# Local port for the app on your Mac (localhost only).
HOST_PORT=8090

# Usernames (comma-separated) that can see /ops and the queue dashboard at /admin/queues.
ADMIN_USERNAMES=

# Sign in with Google (optional; the button only appears when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI:  <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile, the invisible "are you human" check on sign-up (always) and login (after
# 3 failed attempts). Optional: leave both empty to turn it off. docs/DEPLOY.md step 2b.
# Cloudflare dashboard > Turnstile > Add widget > hostname glimpse.ayandev.app, mode "Managed".
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Followers above which a user's posts are pulled at read time instead of pushed to every feed.
# Set it low (e.g. 3) to watch both paths work on a small demo.
FANOUT_THRESHOLD=10000

# Longest allowed live video, in minutes.
MAX_LIVE_MINUTES=60

# Only needed with --profile tunnel. From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token.
CLOUDFLARE_TUNNEL_TOKEN=
