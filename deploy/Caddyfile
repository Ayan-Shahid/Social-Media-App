# One address for the whole app. Caddy load-balances API, media, live-chat and admin traffic
# across the two API instances, and sends everything else to the web app.
{
	admin off
	servers {
		# Real visitor IP from Cloudflare, so rate limits apply per person, not per tunnel.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(api_upstreams) {
	reverse_proxy api-1:4000 api-2:4000 {
		# Round-robin. No sticky sessions needed: Socket.IO is websocket-only and all state is in Postgres/Redis.
		lb_policy round_robin
		lb_retries 2
		# Take an instance out of rotation when its health check fails (e.g. during a restart).
		health_uri /api/health
		health_interval 5s
		health_timeout 2s
		fail_duration 10s
		header_up X-Forwarded-For {client_ip}
	}
}

:80 {
	encode zstd gzip
	request_body {
		max_size 70MB
	}
	header -Server

	# Prometheus metrics are for the Docker network only, never the internet.
	# (handle blocks are tried in order, so this one wins over @api)
	@internal path /api/internal/*
	handle @internal {
		respond 404
	}

	# Object storage (DECISIONS.md D14). Only two doors, each with one verb:
	#   GET  /media/*    processed public files, with headers that stop a browser treating one as a page
	#   PUT  /uploads/*  signed direct uploads. The Host header is passed through untouched, because the
	#                    signature covers it. Reading /uploads (originals) is impossible from outside.
	@media {
		path /media/*
		method GET HEAD
	}
	handle @media {
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; sandbox"
			Content-Disposition inline
			Cross-Origin-Resource-Policy same-origin
			-Server
		}
		reverse_proxy storage:8333
	}
	@upload {
		path /uploads/*
		method PUT
	}
	handle @upload {
		reverse_proxy storage:8333
	}
	@storage_other path /media/* /uploads/*
	handle @storage_other {
		respond 405
	}

	# Live video (DECISIONS.md D16): WebSocket ingest from the broadcaster, HLS out to viewers.
	# One live service: a stream lives in the process that ingests it.
	@live path /stream/*
	handle @live {
		reverse_proxy live:4100 {
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}

	@api path /api/* /socket.io/* /admin/*
	handle @api {
		import api_upstreams
	}
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
